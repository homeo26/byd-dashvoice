<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.homeo.dashvoice"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28"/>

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
      BYDAuto vehicle-control permissions. All are protectionLevel:dangerous
      on this build (verified via `pm list permissions -f`), which means the
      user can grant them at runtime like RECORD_AUDIO. No root, no platform
      signature, no ContextWrapper bypass needed.

      _COMMON = read + write for the subsystem.
    -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_DOOR_LOCK_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON"/>

    <uses-feature android:name="android.hardware.microphone" android:required="true"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".MicKeyService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <receiver android:name=".BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
